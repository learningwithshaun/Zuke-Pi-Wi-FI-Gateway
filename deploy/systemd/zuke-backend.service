[Unit]
Description=Zuke Wi-Fi Gateway - Python Backend Service
After=network.target network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zuke/backend
EnvironmentFile=-/opt/zuke/backend/.env
Environment=FLASK_ENV=production
Environment=GATEWAY_TYPE=nftables
Environment=PYTHONPATH=/opt/zuke
ExecStart=/opt/zuke/backend/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 --access-logfile /var/log/zuke/access.log --error-logfile /var/log/zuke/error.log backend.app:create_app()
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
