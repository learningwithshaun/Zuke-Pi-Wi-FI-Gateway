# ==============================================================================
# Zuke Raspberry Pi Wi-Fi Gateway - Deployment Configuration
# Copy this file to gateway.env on the Raspberry Pi and customize as needed.
# ==============================================================================

# Network Interfaces (Leave blank to auto-detect during setup)
# WAN_IFACE: Internet uplink interface (e.g. eth0, end0, or secondary USB dongle)
# WLAN_IFACE: Wi-Fi Access Point interface (e.g. wlan0)
WAN_IFACE=
WLAN_IFACE=

# Wi-Fi Access Point Settings
WIFI_SSID="Zuke WiFi"
WIFI_CHANNEL=6
WIFI_COUNTRY_CODE="ZA"

# Wi-Fi Customer Subnet Configuration
# Default: 192.168.50.0/24 (Pi Gateway: 192.168.50.1)
SUBNET_BASE="192.168.50"
GATEWAY_IP="${SUBNET_BASE}.1"
NETMASK="255.255.255.0"
DHCP_RANGE_START="${SUBNET_BASE}.10"
DHCP_RANGE_END="${SUBNET_BASE}.250"
DHCP_LEASE_TIME="8h"

# Captive Portal Ports & URLs
BACKEND_PORT=5000
FRONTEND_PORT=80
PORTAL_URL="http://${GATEWAY_IP}/"

# Application Paths
ZUKE_ROOT="/opt/zuke"
BACKEND_DIR="${ZUKE_ROOT}/backend"
FRONTEND_DIST_DIR="${ZUKE_ROOT}/frontend/dist"
DATA_DIR="${ZUKE_ROOT}/data"
BACKUP_DIR="/etc/zuke/backups"
