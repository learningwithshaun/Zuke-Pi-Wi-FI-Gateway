# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key-in-production

# Server Settings
HOST=0.0.0.0
PORT=5000

# Gateway Settings
# GATEWAY_TYPE: mock (for Windows/dev) or nftables (for Raspberry Pi)
GATEWAY_TYPE=mock
SESSION_DURATION_HOURS=8

# Database Path
DATABASE_PATH=data/zuke.db

# Captive Portal Settings
PORTAL_URL=http://192.168.50.1/
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
